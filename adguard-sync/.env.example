# cp to .env, fill in, then:
#   sops -e --input-type dotenv --output-type dotenv .env > .enc.env && shred -u .env

# AdGuard Home admin login. One pair for both instances: the Pi's, which is
# the same one glance's dns-stats widget uses, and set to match in bbox's setup
# wizard. AdGuard has no separate API credential.
ADGUARD_USERNAME=
ADGUARD_PASSWORD=
