# cp to .env, fill in, then:
#   sops -e --input-type dotenv --output-type dotenv .env > .enc.env && shred -u .env

# Where the app is reached. Used to build links and asset URLs, so it must match
# what goes in the browser. Change it if a Caddy route is added later.
APP_URL=http://192.168.1.152:8080

# Laravel's encryption key. Generate once and never change it:
#   echo "base64:$(openssl rand -base64 32)"
# A new key makes everything encrypted with the old one unreadable.
APP_KEY=

# The pricebuddy database user's password, and MySQL's root password.
#   openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# The first login, created when the database is seeded on first start.
APP_USER_EMAIL=
APP_USER_PASSWORD=
