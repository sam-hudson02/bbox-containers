# cp to .env, fill in, then:
#   sops -e --input-type dotenv --output-type dotenv .env > .enc.env && shred -u .env
# .env is gitignored; .enc.env is the committed artefact.

# The aqua checkout on this guest. Keystatic writes into it and Publish pushes
# it, so it is a working copy, not a data directory. Run `npm ci` in it before
# first deploy; the containers use its node_modules, not the image's.
AQUA_DIR=/home/sam/aqua

# The user that owns that checkout. `id -u` and `id -g` on the guest.
# Unset, the containers run as root and write root-owned git objects into it,
# after which that user cannot commit.
HOST_UID=1000
HOST_GID=1000

# The branch Publish pushes to, which staging and production both poll.
PUBLISH_BRANCH=main
PUBLISH_REMOTE=origin

# Where the "open the live site" link on the publish page points. Staging until
# the domain moves to the new production box.
LIVE_URL=https://aqua-staging.samhudson.dev

# The ssh directory holding the deploy key with WRITE access to the repository.
SSH_DIR=/home/sam/.ssh

# Milliseconds of quiet after the last save before preview rebuilds.
PUBLISH_DEBOUNCE_MS=20000
