# cp to .env, fill in, then:
#   sops -e --input-type dotenv --output-type dotenv .env > .enc.env && shred -u .env

# Signs the session cookie. Generate once:
#   head -c 24 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9'
# Changing it logs everyone out of their saved preferences, and nothing else.
SEARXNG_SECRET=
