# cp to .env, fill in, then:
#   sops -e --input-type dotenv --output-type dotenv .env > .enc.env && shred -u .env
# .env is gitignored; .enc.env is the committed artefact.

# The zone Caddy issues certificates under. No leading dot, no scheme.
DOMAIN=

# Cloudflare API token, scoped to the one zone, with BOTH permissions:
#   Zone . DNS  . Edit   writes the _acme-challenge TXT records
#   Zone . Zone . Read   resolves the domain to a zone ID first
# DNS:Edit alone fails at zone lookup with an error that does not read as a
# permissions problem. Its own token, separate from the Pi's caddy and from
# ddns, so one revocation does not take everything down.
CF_API_TOKEN=

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=
