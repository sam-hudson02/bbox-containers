# Caddy on bbox. Aqua Narrowboats only.
#
# The Pi's Caddy serves the personal services. This one exists so that people
# outside the household can be given a Tailscale grant to this address on 443
# and reach these three names, and nothing else on the network.
#
# Add a route: edit this file, redeploy caddy, add the AdGuard rewrite pointing
# the name at 192.168.1.152. Same checklist as the Pi's: add-a-service.

{
	email {$ACME_EMAIL}
}

# DNS-01, because none of these names is reachable from the internet and
# HTTP-01 could never validate. Proves control of the zone instead.
(internal) {
	tls {
		dns cloudflare {$CF_API_TOKEN}
		# Not AdGuard. Before writing the TXT record, CertMagic looks up the SOA
		# for the name to work out which zone it belongs to, walking up a label
		# at a time. AdGuard answers for these names with a rewrite and no SOA,
		# so that walk runs past samhudson.dev to dev., and Cloudflare is then
		# asked for a zone called "dev" it does not have:
		#   expected 1 zone, got 0 for dev.
		# The Pi's Caddy has the same line for the same reason.
		resolvers 1.1.1.1
	}
}

# Basic auth for the two editing surfaces. Tailscale membership is the real
# boundary; this is the second lock, and it is also how the publish page learns
# who is publishing.
#
# Generate a line with:  docker exec -it caddy caddy hash-password
# One user per editor, so the commit history names a person.
#
# Only the salt and digest come from the environment; the $2a$14$ prefix stays
# literal here. Docker compose interpolates $ in .env values, so a whole hash
# put in a variable arrives as "$2a$14" -- silently truncated, Caddy holds a
# malformed hash, every login fails, and nothing in any log says why. The
# bcrypt blob is base64 over ./A-Za-z0-9 and has no $ in it, so it survives.
#
# That prefix assumes bcrypt at cost 14, which is what hash-password gives by
# default. Pass --bcrypt-cost or --algorithm and this line needs changing too,
# or authentication fails with a hash that looks perfectly well formed.
(aqua-editors) {
	basic_auth {
		sam $2a$14${$AQUA_EDITOR_SAM_HASH}
	}
}

# --- Keystatic. Where staff edit the site. -----------------------------------
aqua-cms.{$DOMAIN} {
	import internal
	import aqua-editors

	# Photo uploads go through here.
	request_body {
		max_size 32MB
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-store"
	}

	reverse_proxy 127.0.0.1:4322 {
		# The admin UI holds a save open while it writes files and images.
		transport http {
			read_timeout 120s
		}
	}
}

# --- Preview, and the Publish page. ------------------------------------------
aqua-preview.{$DOMAIN} {
	import internal
	import aqua-editors

	header {
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-store"
	}

	reverse_proxy 127.0.0.1:4323 {
		# Who pressed Publish. The publish page puts this on the commit, so
		# the history says who changed what.
		header_up X-Editor-User {http.auth.user.id}

		# Publishing pushes to GitHub, which can take a moment.
		transport http {
			read_timeout 120s
		}
	}
}

# --- Staging. The live site, on pbox in the DMZ. -----------------------------
#
# Trusted may open connections into the DMZ; the DMZ can never open one back.
# Staging has no inbound path of its own: it polls GitHub rather than taking a
# webhook, so nothing is forwarded to it and this is the only way in.
aqua-staging.{$DOMAIN} {
	import internal
	import aqua-editors

	# Staging serves the same pages as the live site. Without this, search
	# engines would index a second copy and the two would compete. It is not
	# publicly reachable, but the header costs nothing and survives a mistake.
	header X-Robots-Tag "noindex, nofollow"

	# The careers form accepts a CV; the app caps the file itself at 8MB.
	request_body {
		max_size 12MB
	}

	reverse_proxy 192.168.3.10:8080
}
